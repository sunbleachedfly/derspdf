{
  "manifest_version": 3,
  "name": "DersPDF — Gemini & ChatGPT PDF Yap",
  "version": "1.7.4",
  "description": "Gemini ve ChatGPT konuşmalarını, formülleri ve üretilen görselleri seçerek tek tıkla temiz bir PDF'e dönüştürür.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Konuşmayı PDF Yap"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
